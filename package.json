{
  "name": "@propitech/stimulus-widgets",
  "version": "0.3.0",
  "description": "Turbo-safe Stimulus controllers that wrap Choices.js selects, flatpickr date/time pickers, and an Uppy/ActiveStorage avatar upload, with a themeable, variable-driven CSS skin.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Propitech",
  "homepage": "https://github.com/propitech/stimulus-widgets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/propitech/stimulus-widgets.git"
  },
  "bugs": {
    "url": "https://github.com/propitech/stimulus-widgets/issues"
  },
  "keywords": [
    "stimulus",
    "hotwire",
    "turbo",
    "choices.js",
    "flatpickr",
    "uppy",
    "activestorage",
    "select",
    "datepicker",
    "timepicker",
    "avatar-upload"
  ],
  "files": [
    "src",
    "styles"
  ],
  "exports": {
    ".": "./src/index.js",
    "./controllers/select": "./src/controllers/select_controller.js",
    "./controllers/datepicker": "./src/controllers/datepicker_controller.js",
    "./controllers/timepicker": "./src/controllers/timepicker_controller.js",
    "./controllers/avatar-upload": "./src/controllers/avatar_upload_controller.js",
    "./controllers/widget": "./src/controllers/widget_controller.js",
    "./choices_config": "./src/choices_config.js",
    "./styles/variables.css": "./styles/variables.css",
    "./styles/select.css": "./styles/select.css",
    "./styles/flatpickr.css": "./styles/flatpickr.css",
    "./styles/all.css": "./styles/all.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "build:check": "esbuild src/index.js --bundle --format=esm --external:@hotwired/stimulus --external:choices.js --external:flatpickr --external:@uppy/* --external:@excid3/* --external:@rails/activestorage --outfile=/dev/null",
    "test": "playwright test",
    "test:setup": "playwright install --with-deps chromium"
  },
  "peerDependencies": {
    "@excid3/uppy-activestorage-upload": ">=2.0.0",
    "@hotwired/stimulus": ">=3.0.0",
    "@rails/activestorage": ">=7.2",
    "@uppy/core": ">=5.0.0",
    "@uppy/dashboard": ">=5.0.0",
    "@uppy/image-editor": ">=4.0.0",
    "choices.js": ">=10.0.0",
    "flatpickr": ">=4.6.0"
  },
  "peerDependenciesMeta": {
    "@excid3/uppy-activestorage-upload": {
      "optional": true
    },
    "@rails/activestorage": {
      "optional": true
    },
    "@uppy/core": {
      "optional": true
    },
    "@uppy/dashboard": {
      "optional": true
    },
    "@uppy/image-editor": {
      "optional": true
    },
    "choices.js": {
      "optional": true
    },
    "flatpickr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@excid3/uppy-activestorage-upload": "https://github.com/excid3/uppy-activestorage-upload#c660fda179c9fde1ff7926293c967069b55bf662",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.13",
    "@playwright/test": "^1.49.1",
    "@rails/activestorage": "^8.1.300",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.0",
    "@uppy/image-editor": "^4.1.0",
    "choices.js": "^11.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "flatpickr": "^4.6.13",
    "neostandard": "^0.12.0",
    "prettier": "^3.4.2"
  }
}
